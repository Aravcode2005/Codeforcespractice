#include <bits/stdc++.h>
using namespace std;

int main(){
ios_base::sync_with_stdio(0);
cin.tie(0);
cout.tie(0);

int n;
cin>>n;
vector<int>arr(n,-1);
for(int i=0;i<n;i++){
    cin>>arr[i];
}
for(int i=0;i<n;i++){
  if(arr[i]<0){
    arr[i]*=-1;
  }
}
sort(arr.begin(),arr.end());  
cout << arr[0] << endl;
return 0;
}
